[Unit]
Description=BetFriend website (betfriend.bet)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=betfriend
Group=betfriend
WorkingDirectory=/opt/betfriend/current
EnvironmentFile=/etc/betfriend/betfriend.env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=2

# Hardening: the app can only write to its own data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/betfriend
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
